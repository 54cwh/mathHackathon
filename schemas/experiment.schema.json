{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evogenesis.local/schemas/experiment.schema.json",
  "title": "ExperimentRun",
  "meta": {
    "owns": "ExperimentRun 元数据：experiment_id/seed/model_config/arena_config/evolution_config/git_commit/environment",
    "status": "已定稿",
    "note": "ExperimentRun（单 run 元数据）。与 API『实验启动请求』(api/schemas.py::ExperimentLaunch) 为不同对象：后者展开为 N 个本对象。"
  },
  "type": "object",
  "required": [
    "experiment_id",
    "seed",
    "model_config",
    "arena_config",
    "evolution_config"
  ],
  "properties": {
    "experiment_id": {
      "type": "string"
    },
    "seed": {
      "type": "integer"
    },
    "model_config": {
      "type": "string"
    },
    "arena_config": {
      "type": "string"
    },
    "evolution_config": {
      "type": "string"
    },
    "git_commit": {
      "type": "string"
    },
    "environment": {
      "type": "string",
      "enum": ["default", "food_rich", "predator_rich", "resource_scarce"],
      "description": "environment_id（唯一 owner：experiment/实验与评价体系.md §4；基线=default）"
    }
  },
  "additionalProperties": false
}
