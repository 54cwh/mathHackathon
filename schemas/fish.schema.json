{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evogenesis.local/schemas/fish.schema.json",
  "title": "FishState",
  "meta": { "owns": "FishState 快照字段：fish_id/generation/genome_id/viable/energy/size/fitness/cell_counts/metrics", "status": "已冻结" },
  "type": "object",
  "required": [
    "fish_id",
    "generation",
    "genome_id",
    "viable",
    "energy",
    "size"
  ],
  "properties": {
    "fish_id": {
      "type": "string"
    },
    "generation": {
      "type": "integer",
      "minimum": 0
    },
    "genome_id": {
      "type": "string"
    },
    "viable": {
      "type": "boolean"
    },
    "energy": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "size": {
      "type": "number",
      "minimum": 0
    },
    "fitness": {
      "type": [
        "number",
        "null"
      ]
    },
    "cell_counts": {
      "type": "object"
    },
    "metrics": {
      "type": "object"
    }
  }
}