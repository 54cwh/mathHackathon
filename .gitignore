# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# --- uv / venv ---
.venv/

# --- Tool caches ---
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- Jupyter ---
.ipynb_checkpoints/

# --- LaTeX build artifacts ---
*.aux
*.log
*.out
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz
*.xdv
*.nav
*.snm
*.vrb
paper/*.pdf

# --- Node (前端/演示 UI) ---
node_modules/
.next/
dist/
*.tsbuildinfo

# --- 本地技能/资料货架（不入库）---
refs/

# --- 实验产物（可删）---
results/*
!results/figs/
!results/runs/
!results/tables/
results/figs/*
results/runs/*
results/tables/*
!results/figs/.gitkeep
!results/runs/.gitkeep
!results/tables/.gitkeep

# --- 原始数据（大文件不入库）---
data/raw/*
!data/raw/.gitkeep

# --- 模型权重：默认忽略，但冻结演示资产必须入库 ---
*.pt
*.pth
*.ckpt
*.safetensors
!artifacts/**/*.pt
!artifacts/**/*.pth
!artifacts/**/*.ckpt
!artifacts/**/*.safetensors

# --- 密钥/环境变量 ---
.env
.env.*
!.env.example

# --- 系统/编辑器 ---
.DS_Store
Thumbs.db
.idea/
.vscode/

# --- opencode 运行产物 ---
.opencode/node_modules/
.opencode/package.json
.opencode/package-lock.json
