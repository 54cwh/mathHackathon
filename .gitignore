paper/**/*.pdf

# --- Node（app/ 前端与演示 UI）---
node_modules/
.next/
out/
.turbo/
.vercel/
coverage/
*.tsbuildinfo

# --- 实验产物（可删重建）---
results/**
!results/figs/
!results/runs/
!results/tables/
!results/**/.gitkeep

# --- 训练/追踪日志 ---
wandb/
mlruns/
lightning_logs/
*.tfevents.*

# --- 原始数据（大文件不入库）---
data/raw/*
!data/raw/.gitkeep

# --- 模型权重：默认忽略，但冻结演示资产必须入库 ---
*.pt
*.pth
*.ckpt
*.safetensors
!artifacts/**/*.pt
!artifacts/**/*.pth
!artifacts/**/*.ckpt
!artifacts/**/*.safetensors

# --- 密钥/环境变量 ---
.env
.env.*
!.env.example

# --- 系统/编辑器 ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# --- opencode 运行产物 ---
.opencode/node_modules/
.opencode/package.json
.opencode/package-lock.json

# --- 交接包（临时工作产物，消费完可整目录删除）---
handoff/
